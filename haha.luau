local K={125,170,151,7,242,208,93,26,205,119,50,202,39,30,238,205,161,254,162,129,122,70,41,24,124,87,68,109,90,191,123,116}
local S={250,107,15,208,245,13,238,246,183,138,142,173,210,114,45,185}
local C=[[]]
local B="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local M={}
for i=1,#B do M[B:sub(i,i)]=i-1 end
local function D(s)
    local o={}
    local buf=0
    local bits=0
    for i=1,#s do
        local c=s:sub(i,i)
        if c~="=" then
            local v=M[c]
            if v then
                buf=buf*64+v
                bits=bits+6
                while bits>=8 do
                    bits=bits-8
                    o[#o+1]=string.char(math.floor(buf/(2^bits))%256)
                    buf=buf%(2^bits)
                end
            end
        end
    end
    return table.concat(o)
end
local E=D(C)
local state=0
for i=1,#S do state=(state+S[i]*(i*97))%4294967296 end
local O={}
for i=1,#E do
    local idx=((i-1)%#K)+1
    state=(state*1664525+1013904223+K[idx])%4294967296
    local shift=((idx-1)%4)*8
    local stream=(K[idx]+(math.floor(state/(2^shift))%256)+((i*17)%256))%256
    O[i]=string.char((E:byte(i)-stream)%256)
end
return assert(loadstring(table.concat(O)))()
