local B = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function D(s)
    s = s:gsub("[^" .. B .. "=]", "")
    local t = {}
    for i=1,#s,4 do
        local a=B:find(s:sub(i,i),1,true) or 0
        local b=B:find(s:sub(i+1,i+1),1,true) or 0
        local c=B:find(s:sub(i+2,i+2),1,true) or 0
        local d=B:find(s:sub(i+3,i+3),1,true) or 0
        local n=(a-1)*262144+(b-1)*4096+(c-1)*64+(d-1)
        local x=math.floor(n/65536)%256
        local y=math.floor(n/256)%256
        local z=n%256
        t[#t+1]=string.char(x)
        if s:sub(i+2,i+2)~="=" then t[#t+1]=string.char(y) end
        if s:sub(i+3,i+3)~="=" then t[#t+1]=string.char(z) end
    end
    return table.concat(t)
end
local Cipher=D(table.concat(C))
local state=0
for i=1,#S do state=(state+S[i]*(i*97))%4294967296 end
local o={}
for i=1,#Cipher do
    local idx=((i-1)%#K)+1
    state=(state*1664525+1013904223+K[idx])%4294967296
    local shift=((idx-1)%4)*8
    local stream=(K[idx]+math.floor(state/(2^shift))%256+((i*17)%256))%256
    local x=string.byte(Cipher,i)
    o[i]=string.char((x-stream)%256)
end
local Source=table.concat(o)
return assert(loadstring(Source))()
