local K={125,170,151,7,242,208,93,26,205,119,50,202,39,30,238,205,161,254,162,129,122,70,41,24,124,87,68,109,90,191,123,116}
local S={250,107,15,208,245,13,238,246,183,138,142,173,210,114,45,185}
local B64="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64decode(data)
    data=data:gsub("[^"..B64.."=]","")
    local out={}
    local bits,n=0,0
    for i=1,#data do
        local c=data:sub(i,i)
        if c~="=" then
            local v=B64:find(c,1,true)
            if v then
                v=v-1
                bits=bits*64+v
                n=n+6
                if n>=8 then
                    n=n-8
                    out[#out+1]=string.char(math.floor(bits/2^n)%256)
                    bits=bits%2^n
                end
            end
        end
    end
    return table.concat(out)
end
local C=[[]]
local E=b64decode(C)
local state=0
for i,x in ipairs(S) do state=(state+x*(i*97))%4294967296 end
local O={}
for i=1,#E do
    local idx=((i-1)%#K)+1
    state=(state*1664525+1013904223+K[idx])%4294967296
    local shift=((idx-1)%4)*8
    local stream=(K[idx]+(math.floor(state/2^shift)%256)+((i*17)%256))%256
    O[i]=string.char((E:byte(i)-stream)%256)
end
local Source=table.concat(O)
return assert(loadstring(Source))()
